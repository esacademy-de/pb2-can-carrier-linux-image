#!/bin/sh
# pb2-can-carrier-support: enable the carrier units, install the overlay.
set -e

UNITS="pb2-boot-config.service pb2-eth-linkdown.service"
OVERLAY=k3-am62-pocketbeagle2-can-carrier.dtbo

case "$1" in
configure)
	# Images built before this package existed carried copies of these files
	# outside any package; they would shadow the packaged ones.
	rm -f /usr/local/sbin/pb2-boot-config
	for u in $UNITS; do
		if [ -f "/etc/systemd/system/$u" ] && [ ! -L "/etc/systemd/system/$u" ]; then
			rm -f "/etc/systemd/system/$u"
		fi
	done
	# ... and the build-time local repository (only a Packages.gz, so every
	# "apt update" printed three harmless "File not found" errors). The kernel
	# package it installed from stays installed.
	if grep -qs 'file:/opt/pb2-carrier-repo' /etc/apt/sources.list.d/repo_external.list; then
		rm -f /etc/apt/sources.list.d/repo_external.list
		rm -rf /opt/pb2-carrier-repo
	fi
	# A hand-installed copy of the serial-getty drop-in (same file name, so it
	# would shadow the packaged one) is redundant once the package ships it.
	manual=/etc/systemd/system/serial-getty@.service.d/pb2-no-tty-reset.conf
	if [ -f "$manual" ] && cmp -s "$manual" \
		/usr/lib/systemd/system/serial-getty@.service.d/pb2-no-tty-reset.conf; then
		rm -f "$manual"
		rmdir /etc/systemd/system/serial-getty@.service.d 2>/dev/null || true
	fi
	find /etc/systemd/system -maxdepth 2 -type l \
		\( -name pb2-boot-config.service -o -name pb2-eth-linkdown.service \) \
		-lname '/etc/systemd/system/*' -delete 2>/dev/null || true

	# Group for the user-space SPI devices (udev rule 80-pb2-spidev.rules);
	# the default image user gets it, other users: "adduser <name> spi".
	getent group spi >/dev/null || addgroup --system --quiet spi || true
	if getent passwd debian >/dev/null && ! id -nG debian | grep -qw spi; then
		adduser --quiet debian spi || true
	fi

	for u in $UNITS; do
		deb-systemd-helper unmask "$u" >/dev/null || true
		if deb-systemd-helper --quiet was-enabled "$u"; then
			deb-systemd-helper enable "$u" >/dev/null || true
		else
			deb-systemd-helper update-state "$u" >/dev/null || true
		fi
	done
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload || true
		udevadm control --reload 2>/dev/null || true
		udevadm trigger --subsystem-match=spidev 2>/dev/null || true
	fi

	# The overlays are applied by U-Boot from the SD card's FAT partition: the
	# carrier overlay itself, plus the optional ones (k3-...-can-carrier-<name>)
	# that "pb2-overlay enable <name>" can add to the boot entry.
	if [ -d /boot/firmware/overlays ]; then
		for src in "/usr/share/pb2-can-carrier/overlays/$OVERLAY" \
			/usr/share/pb2-can-carrier/overlays/k3-am62-pocketbeagle2-can-carrier-*.dtbo; do
			[ -f "$src" ] || continue
			dst="/boot/firmware/overlays/$(basename "$src")"
			if ! cmp -s "$src" "$dst"; then
				cp "$src" "$dst"
				echo "pb2-can-carrier-support: updated $dst (takes effect at the next boot)"
			fi
		done
	fi
	;;
esac

exit 0
