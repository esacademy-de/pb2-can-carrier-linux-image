# U-Boot config fragment for the PB2 CAN Carrier image.
# Verify against the pinned U-Boot tree (manifests/sources.lock:
# beagleboard/u-boot @ v2026.01-am62-pocketbeagle2, commit
# 7d2af1199011f2210a862097c78f1b940e5d2631) with scripts/kconfig/
# merge_config.sh before first build.
#
# Real defconfigs confirmed present in the pinned tree (two-stage K3
# boot: R5/SPL then A53/main U-Boot):
#   configs/am62_pocketbeagle2_r5_defconfig
#   configs/am62_pocketbeagle2_a53_defconfig
#
# Confirmed by actually configuring am62_pocketbeagle2_a53_defconfig
# locally: this board uses CONFIG_DM_SERIAL=y with driver-model serial,
# so console selection is DT-driven (via U-Boot's own copy of the board
# device tree, arch/arm/dts/k3-am62-pocketbeagle2-u-boot.dtsi + its
# synced dts/upstream base) -- CONFIG_CONS_INDEX does not apply to this
# target and has been removed from this fragment. CONFIG_BAUDRATE=115200
# and CONFIG_OF_LIBFDT_OVERLAY=y are already the defconfig default.
#
# TODO (not yet done): U-Boot's own device tree also defaults its
# console to MAIN_UART6 (same as the Linux side before the carrier
# overlay), same as the k3-am62-pocketbeagle2-u-boot.dtsi pattern used
# for its other carrier-agnostic overrides in that file. That change is
# SPL/U-Boot-stage only and is separate from the kernel-side carrier
# overlay in dts/ -- it has not been written yet.
CONFIG_OF_BOARD_FIXUP=y

# ---------------------------------------------------------------------
# Boot flow
# ---------------------------------------------------------------------
# Confirmed against beagleboard/image-builder
# tools/hwpack/pocketbeagle2-swap.conf: PB2 images boot via U-Boot
# distro_bootcmd + extlinux.conf, not the legacy uEnv.txt mechanism.
# extlinux.conf's template path in that hwpack config
# (.../bb-u-boot-pocketbeagle2/microsd-extlinux-w-swap.conf) is a
# build-local package name inside image-builder's own u-boot packaging
# stage (built from this same pinned beagleboard/u-boot source), not a
# separate external repo -- searched, none found under that name. TODO:
# locate the exact template within image-builder's packaging stage and
# confirm the FDTOVERLAYS/APPEND lines below land in it.
#
# Add to that extlinux.conf entry so the carrier overlay loads on every
# boot and a missing/failed overlay aborts the boot rather than silently
# booting without carrier hardware (work order §7.1, §12):
#
#   FDTOVERLAYS /boot/dtbs/${uname_r}/overlays/k3-am62-pocketbeagle2-can-carrier.dtbo
#
# U-Boot's distro-boot FDTOVERLAYS handling already aborts distro_bootcmd
# with a visible error if a listed .dtbo is missing or fails to apply;
# confirm that behavior against the pinned tree during bring-up (work
# order §12: "A missing/failed overlay must be visible in boot logs and
# treated as a release failure").
#
# APPEND kernel command line (work order §5.5):
#
#   earlycon=ns16550a,mmio32,0x02800000,115200n8 console=ttyS0,115200n8 console=ttyS1,115200n8
#
# earlycon address 0x02800000 is main_uart0's MMIO base (verified against
# k3-am62-main.dtsi: `main_uart0: serial@2800000`) -- this half is
# address-based and does not depend on enumeration order.
#
# The `console=ttySN` device names ARE enumeration-order-dependent.
# CORRECTED reasoning: they are NOT DT-alias-based -- checked the real
# driver source (drivers/tty/serial/8250/8250_omap.c and 8250_core.c at
# linux-stable v6.18): neither calls of_alias_get_id(), so this platform's
# 8250 driver does not use the serial0..serial7 DT aliases to assign
# /dev/ttySN numbers. The actual mechanism is dynamic assignment in
# kernel probe order. Of the UARTs enabled in the final merged tree, only
# main_uart0 (serial@2800000) and main_uart6 (serial@2860000) actually
# probe as ttyS devices (wkup_uart0/main_uart1 are status="reserved" for
# DM firmware and won't). main_uart0 precedes main_uart6 in
# k3-am62-main.dtsi's document/address order, so IF probe order follows
# compiled DTB node order (the common case with no other deferred-probe
# dependency forcing reordering), ttyS0=UART0 and ttyS1=UART6 is the most
# likely mapping -- revised down from an earlier, wrongly-reasoned
# ttyS7/ttyS2 guess. This is still an inference, not a fact: TODO confirm
# the real /dev/ttySN mapping from `dmesg | grep ttyS` on first boot and
# correct these two values before considering CON-01/CON-02 (work order
# §11) satisfied -- this is exactly the ambiguity work order §5.5 calls
# out ("document and test the exact kernel command line ... instead of
# relying on incidental enumeration order"). The first `console=`
# argument wins for /dev/console; list UART0 first since it is the
# required primary.
